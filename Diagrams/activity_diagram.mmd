%% Mental Health Companion System - Activity Diagram (Mermaid)
%% Left-to-Right Layout, Monochrome Theme

graph LR
    %% Styling
    classDef processBox fill:#fff,stroke:#000,stroke-width:2px,color:#000
    classDef decisionBox fill:#fff,stroke:#000,stroke-width:2px,color:#000
    classDef startEnd fill:#000,stroke:#000,stroke-width:2px,color:#fff

    %% ===== USER WORKFLOW =====
    
    %% Start
    START([User Start]):::startEnd
    
    %% 1.0 Authentication
    START --> AUTH_CHECK{Has Account?}:::decisionBox
    AUTH_CHECK -->|Yes| LOGIN[1.1 Login with Credentials]:::processBox
    AUTH_CHECK -->|No| SIGNUP[1.2 Signup with Registration Data]:::processBox
    LOGIN --> VALIDATE[1.3 Validate Credentials]:::processBox
    SIGNUP --> CREATE_ACC[1.4 Create New Account]:::processBox
    VALIDATE --> SESSION[Establish Authenticated Session]:::processBox
    CREATE_ACC --> SESSION
    
    %% Dashboard & Main Loop
    SESSION --> DASHBOARD[User Dashboard]:::processBox
    DASHBOARD --> SELECT_ACTIVITY{Select Activity}:::decisionBox
    
    %% 2.0 Mood Tracking
    SELECT_ACTIVITY -->|Mood Tracking| MOOD_SELECT[2.1 Select Mood Type & Value 1-5]:::processBox
    MOOD_SELECT --> MOOD_NOTES[2.2 Add Optional Notes]:::processBox
    MOOD_NOTES --> MOOD_RECORD[2.3 Record Mood Entry to D2]:::processBox
    MOOD_RECORD --> MOOD_ANALYSIS[2.4 Generate Mood Analysis<br/>Strategy Pattern:<br/>Trend/Pattern/Weekly]:::processBox
    MOOD_ANALYSIS --> MOOD_SUGGEST[2.5 Display Mood Suggestions]:::processBox
    MOOD_SUGGEST --> MOOD_HISTORY[2.6 Show Mood History & Charts]:::processBox
    MOOD_HISTORY --> CONTINUE1{Continue?}:::decisionBox
    CONTINUE1 -->|Yes| DASHBOARD
    
    %% 3.0 Journal Management
    SELECT_ACTIVITY -->|Journal| JOURNAL_ACTION{Journal Action?}:::decisionBox
    
    JOURNAL_ACTION -->|Create| JOURNAL_TITLE[3.1 Enter Title & Content]:::processBox
    JOURNAL_TITLE --> JOURNAL_TYPE[3.2 Select Type<br/>Factory Pattern:<br/>Daily/Gratitude/Goal]:::processBox
    JOURNAL_TYPE --> JOURNAL_SENTIMENT[3.3 Perform Sentiment Analysis]:::processBox
    JOURNAL_SENTIMENT --> JOURNAL_SAVE[3.4 Save to D3]:::processBox
    JOURNAL_SAVE --> CONTINUE2{Continue?}:::decisionBox
    
    JOURNAL_ACTION -->|Update| JOURNAL_SELECT[3.5 Select Existing Entry]:::processBox
    JOURNAL_SELECT --> JOURNAL_MODIFY[3.6 Modify Content]:::processBox
    JOURNAL_MODIFY --> JOURNAL_UPDATE[3.7 Update in D3]:::processBox
    JOURNAL_UPDATE --> CONTINUE2
    
    JOURNAL_ACTION -->|Delete| JOURNAL_DEL_SELECT[3.8 Select Entry]:::processBox
    JOURNAL_DEL_SELECT --> JOURNAL_DELETE[3.9 Delete from D3]:::processBox
    JOURNAL_DELETE --> CONTINUE2
    
    JOURNAL_ACTION -->|View| JOURNAL_DISPLAY[3.10 Display Entries & Stats]:::processBox
    JOURNAL_DISPLAY --> CONTINUE2
    
    CONTINUE2 -->|Yes| DASHBOARD
    
    %% 4.0 AI Chatbot
    SELECT_ACTIVITY -->|Chatbot| CHAT_ENTER[4.1 Enter Chat Message]:::processBox
    CHAT_ENTER --> CHAT_STORE_USER[4.2 Store User Message to D4]:::processBox
    CHAT_STORE_USER --> CHAT_API[4.3 Send to OpenRouter AI]:::processBox
    CHAT_API --> CHAT_RECEIVE[4.4 Receive AI Response]:::processBox
    CHAT_RECEIVE --> CHAT_STORE_BOT[4.5 Store Bot Response to D4]:::processBox
    CHAT_STORE_BOT --> CHAT_DISPLAY[4.6 Display Response]:::processBox
    CHAT_DISPLAY --> CHAT_CONTINUE{Continue Chat?}:::decisionBox
    CHAT_CONTINUE -->|Yes| CHAT_ENTER
    CHAT_CONTINUE -->|No| CONTINUE3{Continue?}:::decisionBox
    CONTINUE3 -->|Yes| DASHBOARD
    
    %% 5.0 Meditation & Resources
    SELECT_ACTIVITY -->|Meditation| MED_REQUEST[5.1 Request Resources]:::processBox
    MED_REQUEST --> MED_TIP[5.2 Display Daily Tip<br/>Deterministic:<br/>Day % Total Tips]:::processBox
    MED_TIP --> MED_LIST[5.3 Show Resources from D6]:::processBox
    MED_LIST --> MED_VIEW[5.4 View Resource Details]:::processBox
    MED_VIEW --> CONTINUE4{Continue?}:::decisionBox
    CONTINUE4 -->|Yes| DASHBOARD
    
    %% 6.0 Profile Management
    SELECT_ACTIVITY -->|Profile| PROFILE_ACTION{Profile Action?}:::decisionBox
    
    PROFILE_ACTION -->|View| PROFILE_GET[6.1 Get Profile from D1]:::processBox
    PROFILE_GET --> PROFILE_STATS[6.2 Get Stats from D2,D3,D4]:::processBox
    PROFILE_STATS --> PROFILE_SHOW[6.3 Display Profile & Stats]:::processBox
    PROFILE_SHOW --> CONTINUE5{Continue?}:::decisionBox
    
    PROFILE_ACTION -->|Update| PROFILE_MODIFY[6.4 Modify Profile Data]:::processBox
    PROFILE_MODIFY --> PROFILE_UPLOAD[6.5 Upload Profile Image]:::processBox
    PROFILE_UPLOAD --> PROFILE_UPDATE[6.6 Update D1]:::processBox
    PROFILE_UPDATE --> CONTINUE5
    
    PROFILE_ACTION -->|Password| PROFILE_OLD_PASS[6.7 Enter Current Password]:::processBox
    PROFILE_OLD_PASS --> PROFILE_NEW_PASS[6.8 Enter New Password]:::processBox
    PROFILE_NEW_PASS --> PROFILE_CHANGE[6.9 Update Password in D1]:::processBox
    PROFILE_CHANGE --> CONTINUE5
    
    PROFILE_ACTION -->|Demo Request| PROFILE_CONSULTANT[6.10 Select Consultant from D7]:::processBox
    PROFILE_CONSULTANT --> PROFILE_TIME[6.11 Choose Time]:::processBox
    PROFILE_TIME --> PROFILE_DEMO[6.12 Submit to D8]:::processBox
    PROFILE_DEMO --> CONTINUE5
    
    CONTINUE5 -->|Yes| DASHBOARD
    
    %% Logout
    SELECT_ACTIVITY -->|Logout| LOGOUT[1.5 Logout Process]:::processBox
    LOGOUT --> STOP([User Stop]):::startEnd
    
    CONTINUE1 -->|No| STOP
    CONTINUE3 -->|No| STOP
    CONTINUE4 -->|No| STOP
    
    
    %% ===== ADMIN WORKFLOW =====
    
    ADMIN_START([Admin Start]):::startEnd
    ADMIN_START --> ADMIN_LOGIN[Admin Login]:::processBox
    ADMIN_LOGIN --> ADMIN_VERIFY{Verify Admin Role<br/>from D1?}:::decisionBox
    ADMIN_VERIFY -->|No| ADMIN_DENIED[Access Denied]:::processBox
    ADMIN_DENIED --> ADMIN_STOP([Admin Stop]):::startEnd
    
    ADMIN_VERIFY -->|Yes| ADMIN_PANEL[7.1 Admin Panel Dashboard]:::processBox
    ADMIN_PANEL --> ADMIN_ACTION{Admin Action?}:::decisionBox
    
    %% 7.0 Admin Analytics
    ADMIN_ACTION -->|View Analytics| ADMIN_QUERY[7.2 Query All Databases<br/>D1,D2,D3,D4,D6]:::processBox
    ADMIN_QUERY --> ADMIN_CALC[7.3 Calculate Statistics<br/>Users, Journals, Moods, etc.]:::processBox
    ADMIN_CALC --> ADMIN_DISPLAY[7.4 Display Analytics Dashboard]:::processBox
    ADMIN_DISPLAY --> ADMIN_CONTINUE{Continue?}:::decisionBox
    
    %% Resource Management
    ADMIN_ACTION -->|Manage Resources| RES_ACTION{Resource Action?}:::decisionBox
    
    RES_ACTION -->|Create| RES_CREATE[5.5 Enter Resource Data]:::processBox
    RES_CREATE --> RES_INSERT[5.6 Insert to D6]:::processBox
    RES_INSERT --> ADMIN_CONTINUE
    
    RES_ACTION -->|Update| RES_SELECT[5.7 Select Resource]:::processBox
    RES_SELECT --> RES_MODIFY[5.8 Modify Data]:::processBox
    RES_MODIFY --> RES_UPDATE[5.9 Update D6]:::processBox
    RES_UPDATE --> ADMIN_CONTINUE
    
    RES_ACTION -->|Delete| RES_DEL_SELECT[5.10 Select Resource]:::processBox
    RES_DEL_SELECT --> RES_DELETE[5.11 Delete from D6]:::processBox
    RES_DELETE --> ADMIN_CONTINUE
    
    ADMIN_CONTINUE -->|Yes| ADMIN_PANEL
    ADMIN_CONTINUE -->|No| ADMIN_LOGOUT[Admin Logout]:::processBox
    ADMIN_LOGOUT --> ADMIN_STOP

