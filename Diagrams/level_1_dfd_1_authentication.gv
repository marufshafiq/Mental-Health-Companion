digraph level_1_authentication {
    // Graph settings for clean, academic appearance
    graph [rankdir=LR, splines=ortho, nodesep=0.8, ranksep=1.2, bgcolor=white];
    node [fontname="Arial", fontsize=11];
    edge [fontname="Arial", fontsize=10];
    
    // Title
    labelloc="t";
    label="Level 1 DFD - 1.0 Authentication Management\n\n";
    
    // External Entity (rectangle, double border)
    USER [label="USER", shape=box, style="bold", penwidth=2];
    
    // Processes (circles/ellipses)
    P11 [label="1.1\n\nLogin\nProcess", shape=circle, width=1.2, height=1.2, style="bold", penwidth=2];
    P12 [label="1.2\n\nSignup\nProcess", shape=circle, width=1.2, height=1.2, style="bold", penwidth=2];
    P13 [label="1.3\n\nLogout\nProcess", shape=circle, width=1.2, height=1.2, style="bold", penwidth=2];
    
    // Data Store (parallel lines)
    D1 [label="D1: users", shape=cylinder, style="bold", penwidth=2];
    
    // Data Flows - Login Process
    USER -> P11 [label="  Username,\n  Password"];
    P11 -> D1 [label="  Query User\n  Credentials"];
    D1 -> P11 [label="  User Record"];
    P11 -> USER [label="  Session Token,\n  User Info"];
    
    // Data Flows - Signup Process
    USER -> P12 [label="  Registration\n  Data"];
    P12 -> D1 [label="  Insert New\n  User"];
    D1 -> P12 [label="  User ID"];
    P12 -> USER [label="  Account Created,\n  Session Token"];
    
    // Data Flows - Logout Process
    USER -> P13 [label="  Logout\n  Request"];
    P13 -> USER [label="  Session\n  Terminated"];
    
    // Invisible edges for better layout
    {rank=same; P11; P12; P13;}
}
