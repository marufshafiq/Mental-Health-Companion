digraph level_1_mood_tracking {
    // Graph settings for clean, academic appearance
    graph [rankdir=LR, splines=ortho, nodesep=0.8, ranksep=1.2, bgcolor=white];
    node [fontname="Arial", fontsize=11];
    edge [fontname="Arial", fontsize=10];
    
    // Title
    labelloc="t";
    label="Level 1 DFD - 2.0 Mood Tracking\n\n";
    
    // External Entity
    USER [label="USER", shape=box, style="bold", penwidth=2];
    
    // Processes
    P21 [label="2.1\n\nRecord\nMood", shape=circle, width=1.2, height=1.2, style="bold", penwidth=2];
    P22 [label="2.2\n\nMood\nAnalysis\n(Strategy)", shape=circle, width=1.3, height=1.3, style="bold", penwidth=2];
    P23 [label="2.3\n\nMood\nSuggestions", shape=circle, width=1.2, height=1.2, style="bold", penwidth=2];
    P24 [label="2.4\n\nMood\nHistory", shape=circle, width=1.2, height=1.2, style="bold", penwidth=2];
    
    // Data Store
    D2 [label="D2: mood_entries", shape=cylinder, style="bold", penwidth=2];
    
    // Data Flows - Record Mood
    USER -> P21 [label="  Mood Type,\n  Mood Value,\n  Notes"];
    P21 -> D2 [label="  Insert Mood\n  Entry"];
    D2 -> P21 [label="  Entry ID"];
    P21 -> USER [label="  Confirmation"];
    
    // Data Flows - Mood Analysis
    USER -> P22 [label="  Analysis\n  Request"];
    P22 -> D2 [label="  Query Mood\n  Entries"];
    D2 -> P22 [label="  Mood Data"];
    P22 -> USER [label="  Trend Analysis,\n  Patterns,\n  Weekly Summary"];
    
    // Data Flows - Mood Suggestions
    USER -> P23 [label="  Current\n  Mood"];
    P23 -> USER [label="  Coping\n  Suggestions,\n  Emergency\n  Resources"];
    
    // Data Flows - Mood History
    USER -> P24 [label="  History\n  Request"];
    P24 -> D2 [label="  Query History"];
    D2 -> P24 [label="  Historical\n  Mood Entries"];
    P24 -> USER [label="  Mood Charts,\n  Timeline"];
    
    // Layout arrangement
    {rank=same; P21; P22;}
    {rank=same; P23; P24;}
}
