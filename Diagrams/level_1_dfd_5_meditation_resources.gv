digraph level_1_meditation_resources {
    // Graph settings for clean, academic appearance
    graph [rankdir=LR, splines=ortho, nodesep=0.8, ranksep=1.2, bgcolor=white];
    node [fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=9];
    
    // Title
    labelloc="t";
    label="Level 1 DFD - 5.0 Meditation & Resources\n\n";
    
    // External Entities
    USER [label="USER", shape=box, style="bold", penwidth=2];
    ADMIN [label="ADMIN", shape=box, style="bold", penwidth=2];
    
    // Processes
    P51 [label="5.1\n\nDaily\nTip-of-Day\n(Deterministic)", shape=circle, width=1.3, height=1.3, style="bold", penwidth=2];
    P52 [label="5.2\n\nFetch\nResources", shape=circle, width=1.1, height=1.1, style="bold", penwidth=2];
    P53 [label="5.3\n\nCreate\nResource\n(Admin)", shape=circle, width=1.2, height=1.2, style="bold", penwidth=2];
    P54 [label="5.4\n\nUpdate/Delete\nResource\n(Admin)", shape=circle, width=1.3, height=1.3, style="bold", penwidth=2];
    
    // Data Stores
    D5 [label="D5: tips", shape=cylinder, style="bold", penwidth=2];
    D6 [label="D6: resources", shape=cylinder, style="bold", penwidth=2];
    
    // Data Flows - Daily Tip
    USER -> P51 [label="  Tip Request"];
    P51 -> D5 [label="  Query Tip\n  (Day Modulo)"];
    D5 -> P51 [label="  Tip Text"];
    P51 -> USER [label="  Daily Tip"];
    
    // Data Flows - Fetch Resources
    USER -> P52 [label="  View Resources\n  Request"];
    P52 -> D6 [label="  Query Resources"];
    D6 -> P52 [label="  Resource List"];
    P52 -> USER [label="  Meditation\n  Resources"];
    
    // Data Flows - Create Resource
    ADMIN -> P53 [label="  New Resource\n  Data"];
    P53 -> D6 [label="  Insert Resource"];
    D6 -> P53 [label="  Resource ID"];
    P53 -> ADMIN [label="  Creation\n  Confirmed"];
    
    // Data Flows - Update/Delete Resource
    ADMIN -> P54 [label="  Resource ID,\n  Updated Data /\n  Delete Request"];
    P54 -> D6 [label="  Update/Delete\n  Resource"];
    D6 -> P54 [label="  Success"];
    P54 -> ADMIN [label="  Operation\n  Confirmed"];
    
    // Layout arrangement
    {rank=same; P51; P52;}
    {rank=same; P53; P54;}
    {rank=same; D5; D6;}
}
