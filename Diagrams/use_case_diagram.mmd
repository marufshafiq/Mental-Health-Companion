%% Mental Health Companion System - Use Case Diagram
%% Academic Style - Clear, Professional, Non-Overlapping
%% Strictly Follows DFD Structure (7 Subprocesses: 1.0-7.0)

flowchart LR
    %% Actor Styling
    classDef actorStyle fill:#000,stroke:#000,stroke-width:3px,color:#fff,font-weight:bold
    classDef useCaseStyle fill:#fff,stroke:#000,stroke-width:2px,color:#000
    classDef systemStyle fill:#f5f5f5,stroke:#000,stroke-width:2px
    
    %% ===== ACTORS =====
    USER(("👤<br/>USER")):::actorStyle
    ADMIN(("👨‍💼<br/>ADMIN")):::actorStyle
    API(("🤖<br/>OpenRouter AI<br/>External System")):::actorStyle
    
    %% ===== SYSTEM BOUNDARY =====
    subgraph SYSTEM["☁️ MENTAL HEALTH COMPANION SYSTEM"]
        direction TB
        
        %% ROW 1: Authentication
        subgraph ROW1[" "]
            direction LR
            subgraph AUTH["1.0 AUTHENTICATION MANAGEMENT"]
                UC1_1("1.1<br/>Login")
                UC1_2("1.2<br/>Signup")
                UC1_3("1.3<br/>Logout")
            end
        end
        
        %% ROW 2: Mood & Journal
        subgraph ROW2[" "]
            direction LR
            subgraph MOOD["2.0 MOOD TRACKING"]
                UC2_1("2.1<br/>Record Mood")
                UC2_2("2.2<br/>Analyze Mood<br/><i>Strategy Pattern</i>")
                UC2_3("2.3<br/>View Suggestions")
                UC2_4("2.4<br/>View History")
            end
            
            subgraph JOURNAL["3.0 JOURNAL MANAGEMENT"]
                UC3_1("3.1<br/>Analyze Sentiment")
                UC3_2("3.2<br/>Create Entry<br/><i>Factory Pattern</i>")
                UC3_3("3.3<br/>Update Entry")
                UC3_4("3.4<br/>Delete Entry")
                UC3_5("3.5<br/>Toggle Favorite")
                UC3_6("3.6<br/>View Statistics")
            end
        end
        
        %% ROW 3: Chatbot & Meditation
        subgraph ROW3[" "]
            direction LR
            subgraph CHATBOT["4.0 AI CHATBOT SERVICE"]
                UC4_1("4.1<br/>Send Message")
                UC4_2("4.2<br/>Process Request")
                UC4_3("4.3<br/>Receive Response")
            end
            
            subgraph MEDITATION["5.0 MEDITATION & RESOURCES"]
                UC5_1("5.1<br/>View Daily Tip<br/><i>Deterministic</i>")
                UC5_2("5.2<br/>Browse Resources")
                UC5_3("5.3<br/>Create Resource<br/><i>Admin</i>")
                UC5_4("5.4<br/>Update Resource<br/><i>Admin</i>")
                UC5_5("5.5<br/>Delete Resource<br/><i>Admin</i>")
            end
        end
        
        %% ROW 4: Profile & Admin
        subgraph ROW4[" "]
            direction LR
            subgraph PROFILE["6.0 PROFILE MANAGEMENT"]
                UC6_1("6.1<br/>View Profile")
                UC6_2("6.2<br/>View Statistics")
                UC6_3("6.3<br/>Update Profile")
                UC6_4("6.4<br/>Change Password")
                UC6_5("6.5<br/>Request Demo")
            end
            
            subgraph ADMINPANEL["7.0 ADMIN PANEL"]
                UC7_1("7.1<br/>View Analytics")
                UC7_2("7.2<br/>Generate Reports")
            end
        end
    end
    
    %% ===== USER ASSOCIATIONS =====
    USER -.-> UC1_1
    USER -.-> UC1_2
    USER -.-> UC1_3
    
    USER -.-> UC2_1
    USER -.-> UC2_2
    USER -.-> UC2_3
    USER -.-> UC2_4
    
    USER -.-> UC3_1
    USER -.-> UC3_2
    USER -.-> UC3_3
    USER -.-> UC3_4
    USER -.-> UC3_5
    USER -.-> UC3_6
    
    USER -.-> UC4_1
    USER -.-> UC4_3
    
    USER -.-> UC5_1
    USER -.-> UC5_2
    
    USER -.-> UC6_1
    USER -.-> UC6_2
    USER -.-> UC6_3
    USER -.-> UC6_4
    USER -.-> UC6_5
    
    %% ===== ADMIN ASSOCIATIONS =====
    ADMIN -.-> UC1_1
    ADMIN -.-> UC5_3
    ADMIN -.-> UC5_4
    ADMIN -.-> UC5_5
    ADMIN -.-> UC7_1
    ADMIN -.-> UC7_2
    
    %% ===== EXTERNAL API ASSOCIATION =====
    UC4_2 <-.-> API
    
    %% Apply Styling
    class UC1_1,UC1_2,UC1_3 useCaseStyle
    class UC2_1,UC2_2,UC2_3,UC2_4 useCaseStyle
    class UC3_1,UC3_2,UC3_3,UC3_4,UC3_5,UC3_6 useCaseStyle
    class UC4_1,UC4_2,UC4_3 useCaseStyle
    class UC5_1,UC5_2,UC5_3,UC5_4,UC5_5 useCaseStyle
    class UC6_1,UC6_2,UC6_3,UC6_4,UC6_5 useCaseStyle
    class UC7_1,UC7_2 useCaseStyle
    class AUTH,MOOD,JOURNAL,CHATBOT,MEDITATION,PROFILE,ADMINPANEL systemStyle
